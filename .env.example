# Copy this file to `.env` (same folder) and fill in your real values.
# `.env` itself is gitignored - never commit real credentials.

# --- TeamSL (basketball-bund.net) login, used by fetchSchedule.py ---
TEAMSL_USERNAME=your-teamsl-username
TEAMSL_PASSWORD=your-teamsl-password
TEAMSL_LOGIN_URL=https://www.basketball-bund.net/login.do?reqCode=showLogin

# --- Local MySQL connection ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=spielplanung

# --- Where the finished Excel reports are written (your Google Drive folder) ---
OUTPUT_DIR=G:\My Drive\Spielplanung
